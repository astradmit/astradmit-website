From 09a90120a5049ed24195478a20467a8e08e5fecf Mon Sep 17 00:00:00 2001
From: Astradmit <noreply@example.com>
Date: Mon, 16 Nov 2026 14:05:27 +0000
Subject: [PATCH] fix: implement responsive homepage banners for mobile and
 desktop

---
 site/assets/css/style.css                      |   4 ++++
 site/assets/img/strategy-banner-1200.webp      | Bin 0 -> 44662 bytes
 site/assets/img/strategy-banner-mobile-720.jpg | Bin 0 -> 100531 bytes
 .../assets/img/strategy-banner-mobile-720.webp | Bin 0 -> 52850 bytes
 site/assets/img/strategy-banner-mobile.jpg     | Bin 0 -> 168846 bytes
 site/assets/img/strategy-banner-mobile.webp    | Bin 0 -> 83922 bytes
 site/assets/img/strategy-banner.webp           | Bin 0 -> 92608 bytes
 site/index.html                                |   7 ++++++-
 8 files changed, 10 insertions(+), 1 deletion(-)
 create mode 100644 site/assets/img/strategy-banner-1200.webp
 create mode 100644 site/assets/img/strategy-banner-mobile-720.jpg
 create mode 100644 site/assets/img/strategy-banner-mobile-720.webp
 create mode 100644 site/assets/img/strategy-banner-mobile.jpg
 create mode 100644 site/assets/img/strategy-banner-mobile.webp
 create mode 100644 site/assets/img/strategy-banner.webp

diff --git a/site/assets/css/style.css b/site/assets/css/style.css
index 65c9399..bd326aa 100644
--- a/site/assets/css/style.css
+++ b/site/assets/css/style.css
@@ -189,3 +189,7 @@ legend+*{clear:both}
 .strategy-banner{width:100%;height:auto;border-radius:var(--radius);box-shadow:var(--shadow)}
 .strategy-text{max-width:52em;margin:34px auto 0}.strategy-text p{font-size:1.08rem;color:var(--slate)}
 .strategy-cta{margin:26px 0 0;text-align:center}
+/* responsive strategy banner (home): wide artwork on tablet/desktop, portrait artwork on phones */
+.strategy-picture{display:block;width:100%;max-width:100%}
+.strategy-picture .strategy-banner{display:block;width:100%;max-width:100%;height:auto}
+@media (max-width:640px){.strategy-picture{max-width:560px;margin-inline:auto}.strategy-picture .strategy-banner{border-radius:0;box-shadow:none}}
diff --git a/site/assets/img/strategy-banner-1200.webp b/site/assets/img/strategy-banner-1200.webp
new file mode 100644
index 0000000000000000000000000000000000000000..c584794ee2e7b122489386735435f417502ccbc1
